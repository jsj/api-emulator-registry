  "fidelity": {
    "routes": 1,
    "schemas": 0.82,
    "auth": 1,
    "errors": 0.85,
    "pagination": 0.9,
    "state": 0.9,
    "officialClient": 0.2
  },
  "notes": [
    "Every operation in XBOW API version 2026-07-01 is registered and exercised by direct smoke coverage.",
    "The live official OpenAPI operation matrix is compared with the exported emulator route manifest."
  ]
