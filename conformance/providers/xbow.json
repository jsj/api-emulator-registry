{
  "provider": "xbow",
  "catalog": {
    "slug": "xbow",
    "specifier": "./@xbow/api-emulator.mjs"
  },
  "sources": {
    "docs": ["https://docs.xbow.com/api/"],
    "openapi": "https://docs.xbow.com/api/openapi-2026-07-01.json"
  },
  "validation": {
    "directSmoke": "node @xbow/smoke.mjs",
